# Neon Postgres (Vercel integration or Neon dashboard)
DATABASE_URL=
# Direct connection for migrations (Neon unpooled endpoint)
DATABASE_URL_UNPOOLED=

# Public site URL for preview links and metadata (optional until domain is set)
NEXT_PUBLIC_SITE_URL=

# Admin auth — DB-backed sessions (no AUTH_SECRET / ADMIN_EMAIL / ADMIN_PASSWORD)

# Vercel Blob — shared thinkbigdigital-blob store (Parth uploads use parthwebsite/ prefix)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
